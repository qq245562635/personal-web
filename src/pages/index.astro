---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostItem from '../components/PostItem.astro';
import { getPublishedPosts } from '../lib/posts';
import { withBase } from '../lib/url';

const posts = await getPublishedPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
---

<Base>
  {
    featured ? (
      <a class="featured" href={withBase(`/posts/${featured.id}/`)}>
        <span class="kicker">精选{featured.data.tags[0] ? ` · ${featured.data.tags[0]}` : ''}</span>
        {featured.data.cover && <Image class="cover" src={featured.data.cover} alt="" />}
        <h2 class="featured-title">{featured.data.title}</h2>
        {featured.data.summary && <p class="summary">{featured.data.summary}</p>}
        {featured.data.tags.length > 0 && <span class="meta">{featured.data.tags.join(' · ')}</span>}
      </a>
    ) : (
      <p class="empty">还没有文章。</p>
    )
  }

  {
    rest.length > 0 && (
      <section class="more">
        <h2 class="section-title">更多文章</h2>
        {rest.map((post) => (
          <PostItem post={post} />
        ))}
      </section>
    )
  }
</Base>
