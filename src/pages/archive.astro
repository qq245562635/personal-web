---
import Base from '../layouts/Base.astro';
import { getAllTags, getPublishedPosts, type Post } from '../lib/posts';
import { formatDate, withBase } from '../lib/url';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);

const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<Base title="归档">
  <h1 class="page-title">归档</h1>

  {
    tags.length > 0 && (
      <p class="tag-cloud">
        {tags.map((tag) => (
          <a href={withBase(`/tags/${tag}/`)}>{tag}</a>
        ))}
      </p>
    )
  }

  {
    [...byYear.entries()].map(([year, list]) => (
      <section class="archive-year">
        <h2 class="section-title">{year}</h2>
        <ul class="archive-list">
          {list.map((post) => (
            <li>
              <time class="meta" datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date).slice(5)}
              </time>
              <a href={withBase(`/posts/${post.id}/`)}>{post.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
